{
  "name": "@demo2song/contract-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "codegen": "openapi-typescript ../contract/openapi.yaml -o src/schema.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.13.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
