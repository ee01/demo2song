{
  "$schema": "./config.schema.json",
  "defaultProvider": "minimax",
  "models": {
    "minimax": {
      "demoModel": "music-cover",
      "fullModel": "music-2.6",
      "allowPaidModels": true
    },
    "mureka": {
      "demoModel": "auto",
      "fullModel": "auto",
      "allowPaidModels": false
    }
  },
  "limits": {
    "minRecordingSeconds": 6,
    "maxRecordingSeconds": 60,
    "demoTargetSeconds": 30,
    "fullSongMinSeconds": 120,
    "fullSongMaxSeconds": 240,
    "dailyDemoJobsPerUser": 0,
    "dailyExtendJobsPerUser": 100,
    "refundQuotaOnProviderFailure": true
  },
  "storage": {
    "provider": "cos",
    "recordingRetention": "permanent",
    "songRetention": "permanent",
    "signedUrlTtlSeconds": 900
  },
  "features": {
    "enableExtendSong": true,
    "enableApproximateMinimaxExtend": false,
    "enableCommercialUseGate": false
  }
}
